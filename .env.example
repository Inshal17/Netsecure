# Example environment variables
# Use SQLite (default) — no DATABASE_URL required

# To use Postgres, set DATABASE_URL to a postgres connection string, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/netsecure

# To use S3-compatible object storage for raw uploads set these:
# S3_BUCKET=my-bucket
# S3_ENDPOINT=https://s3.my-provider.example
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Optional: override uploads directory (local fallback)
# UPLOADS_DIR=/var/lib/netsecure/uploads

# Supabase backend integration
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace-with-a-server-only-secret
# SUPABASE_BUCKET=configurations
